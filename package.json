{
  "name": "zumly",
  "version": "1.2.3",
  "description": "Javascript library for building zooming user interfaces",
  "type": "module",
  "author": "Juan Martin Muda - Zumerlab",
  "license": "MIT",
  "homepage": "https://zumerlab.com/zumly/",
  "repository": {
    "type": "git",
    "url": "https://github.com/zumerlab/zumly.git"
  },
  "bugs": {
    "url": "https://github.com/zumerlab/zumly/issues"
  },
  "keywords": [
    "zumly",
    "zooming",
    "javascript",
    "UI",
    "library",
    "ZUI"
  ],
  "main": "dist/zumly.cjs",
  "module": "dist/zumly.mjs",
  "types": "types/zumly.d.ts",
  "exports": {
    ".": {
      "types": "./types/zumly.d.ts",
      "import": "./dist/zumly.mjs",
      "require": "./dist/zumly.cjs",
      "default": "./dist/zumly.mjs"
    },
    "./style.css": "./dist/zumly.css",
    "./css": "./dist/zumly.css",
    "./drivers": {
      "types": "./src/drivers/index.d.ts",
      "import": "./src/drivers/index.js"
    },
    "./driver-helpers": {
      "types": "./src/drivers/driver-helpers.d.ts",
      "import": "./src/drivers/driver-helpers.js"
    }
  },
  "sideEffects": [
    "dist/zumly.css",
    "dist/zumly.min.css"
  ],
  "scripts": {
    "compile": "node esbuild.config.mjs",
    "dev": "npm run compile && npx serve . -p 9090 -c ./serve.json",
    "test": "npx vitest run --browser.headless --reporter=verbose",
    "test:browsers": "node scripts/test-browsers.mjs",
    "test:pack": "npm run compile && node scripts/verify-package.mjs",
    "test:unit": "npx vitest run __tests__/utils.test.js --reporter=verbose",
    "test:coverage": "npx vitest run --browser.headless --coverage",
    "test:install-browsers": "npx playwright install chromium firefox webkit",
    "bump": "npx @zumerbox/bump && npx @zumerbox/changelog",
    "prepack": "npm run compile",
    "build": "npm run compile && npm pack",
    "release:push": "git add . && git commit -m \"Bumped version\" && git push --follow-tags"
  },
  "files": [
    "dist",
    "types",
    "src/drivers",
    "src/view-visibility.js",
    "src/view-lifecycle.js",
    "docs/DRIVER_API.md",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@zumer/snapdom": "^3.7.0",
    "@zumer/snapdom-plugins": "^4.4.1"
  },
  "peerDependenciesMeta": {
    "@zumer/snapdom": {
      "optional": true
    },
    "@zumer/snapdom-plugins": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitest/browser": "^3.1.2",
    "@vitest/coverage-v8": "^3.1.2",
    "@zumer/snapdom": "^3.7.0",
    "@zumer/snapdom-plugins": "^4.4.1",
    "esbuild": "^0.27.4",
    "playwright": "^1.52.0",
    "vitest": "^3.1.2"
  }
}
